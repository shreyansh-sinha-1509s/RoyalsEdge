{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd webapp/backend && npm ci && npx prisma generate && cd ../frontend && npm ci",
  "buildCommand": "cd webapp/frontend && npm run build",
  "outputDirectory": "webapp/frontend/dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "includeFiles": "{submission/**,outputs/ranking_robustness.csv,outputs/pressure_model_comparison.csv,outputs/shortlist_alternatives.csv,webapp/backend/node_modules/.prisma/**}"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}

