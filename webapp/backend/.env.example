# RR PERFORMANCE LAB — Backend Environment Configuration Template
# Copy this file to .env and fill in your real values locally.
# NEVER commit .env or paste real credentials into chat or version control.

NODE_ENV=development
PORT=5000

# Neon PostgreSQL connection strings (from Neon Console -> Connection Details)
# Pooled URL (contains -pooler in hostname) for runtime application queries:
DATABASE_URL="YOUR_NEON_POOLED_CONNECTION_STRING"
# Direct URL (non-pooler hostname) for Prisma schema migrations:
DIRECT_URL="YOUR_NEON_DIRECT_CONNECTION_STRING"

# Admin JWT signing secret (generate a 64+ char random hex string locally)
# PowerShell: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET"
JWT_EXPIRES_IN="8h"

# Allowed frontend origin(s) for CORS (comma-separated for multiple origins)
FRONTEND_ORIGIN="http://localhost:5173"

# Admin bootstrap email (password is NEVER stored in .env; entered interactively in bootstrap script)
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"

