// 10. Matches (853 eligible IPL + T20I matches; 837 with ball data + 16 abandoned)
model Match {
  matchId                        Int       @id @map("match_id")
  compId                         Int       @map("comp_id")
  compName                       String    @map("comp_name")
  matchFormat                    String    @map("match_format")
  season                         String    @map("season")
  eligibilityCategory            String    @map("eligibility_category")
  matchNumber                    String?   @map("match_number")
  matchDate                      DateTime  @map("match_date")
  stage                          String?   @map("stage")
  venueId                        Int?      @map("venue_id")
  venueCountry                   String?   @map("venue_country")
  homeTeamId                     Int?      @map("home_team_id")
  homeTeam                       String    @map("home_team")
  awayTeamId                     Int?      @map("away_team_id")
  awayTeam                       String    @map("away_team")
  tossWinTeamId                  Int?      @map("toss_win_team_id")
  tossOpted                      String?   @map("toss_opted")
  knockOut                       Boolean   @default(false) @map("knock_out")
  winTeamId                      Int?      @map("win_team_id")
  result                         String?   @map("result")
  hasBallData                    Boolean   @default(false) @map("has_ball_data")
  isAbandonedMatch               Boolean   @default(false) @map("is_abandoned_match")
  isNoResultMatch                Boolean   @default(false) @map("is_no_result_match")
  isDlsMatch                     Boolean   @default(false) @map("is_dls_match")
  isReducedOversMatch            Boolean   @default(false) @map("is_reduced_overs_match")
  matchCompletionClassification  String    @map("match_completion_classification")
  regularDeliveries              Int       @default(0) @map("regular_deliveries")
  regularLegalDeliveries         Int       @default(0) @map("regular_legal_deliveries")
  inningsRecordedCount           Int       @default(0) @map("innings_recorded_count")
  inn1TotalRuns                  Int?      @map("inn1_total_runs")
  inn1Wickets                    Int?      @map("inn1_wickets")
  inn1LegalBalls                 Int?      @map("inn1_legal_balls")
  inn2TotalRuns                  Int?      @map("inn2_total_runs")
  inn2Wickets                    Int?      @map("inn2_wickets")
  inn2LegalBalls                 Int?      @map("inn2_legal_balls")
  revisedTargetNum               Int?      @map("revised_target_num")

  meanI1Pressure                 Float?    @map("mean_i1_pressure")
  maxI1Pressure                  Float?    @map("max_i1_pressure")
  meanChasePressure              Float?    @map("mean_chase_pressure")
  maxChasePressure               Float?    @map("max_chase_pressure")
  meanBowlingPressure            Float?    @map("mean_bowling_pressure")
  maxBowlingPressure             Float?    @map("max_bowling_pressure")
  highOrExtremeBattingBalls      Int?      @map("high_or_extreme_batting_balls")
  highOrExtremeBowlingBalls      Int?      @map("high_or_extreme_bowling_balls")

  innings Innings[]

  @@index([matchFormat, season])
  @@index([matchDate])
  @@index([compId])
  @@index([matchCompletionClassification])
  @@map("matches")
}

// 11. Innings (1,652 primary regular innings)
model Innings {
  id                         Int      @id @default(autoincrement())
  matchId                    Int      @map("match_id")
  innings                    Int      @map("innings")
  compId                     Int      @map("comp_id")
  compName                   String   @map("comp_name")
  matchFormat                String   @map("match_format")
