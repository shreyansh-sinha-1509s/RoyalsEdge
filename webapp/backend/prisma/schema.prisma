}

// 14. Admin Users (secure bcrypt password hash only; no public registration)
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique @map("email")
  passwordHash String    @map("password_hash")
  role         String    @default("ADMIN") @map("role")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  importLogs   DataImportLog[]
  auditLogs    AdminAuditLog[]

  @@map("admin_users")
}

// 15. Data Import Logs (audit trail for every CSV import run)
model DataImportLog {
  id               Int       @id @default(autoincrement())
  batchId          String    @unique @map("batch_id")
  triggeredBy      String    @default("CLI") @map("triggered_by")
  adminUserId      Int?      @map("admin_user_id")
  status           String    @map("status")
  sourceRowCount   Int       @default(0) @map("source_row_count")
  insertedCount    Int       @default(0) @map("inserted_count")
  skippedCount     Int       @default(0) @map("skipped_count")
  tableCountsJson  Json?     @map("table_counts_json")
  reconcilePassed  Boolean?  @map("reconcile_passed")
  reconcileSummary Json?     @map("reconcile_summary")
  errorsJson       Json?     @map("errors_json")
  durationMs       Int?      @map("duration_ms")
  startedAt        DateTime  @default(now()) @map("started_at")
  completedAt      DateTime? @map("completed_at")

  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([startedAt])
  @@index([status])
  @@map("data_import_logs")
}

