// 6. Player Pressure Exposure (1,420 rows = 824 batting + 596 bowling)
model PlayerPressureExposure {
  id                    Int     @id @default(autoincrement())
  discipline            String  @map("discipline")
  playerId              Int     @map("player_id")
  playerName            String  @map("player_name")
  role                  String  @map("role")
  evidenceTier          String  @map("evidence_tier")
  isPrimaryEligible     Boolean @default(false) @map("is_primary_eligible")
  pressureBalls         Int     @default(0) @map("pressure_balls")
  pressureInnings       Int     @default(0) @map("pressure_innings")
  pressureMatches       Int     @default(0) @map("pressure_matches")
  pressureSeasons       Int     @default(0) @map("pressure_seasons")
  evidenceStrengthScore Float?  @map("evidence_strength_score")
  extremePressureBalls  Int     @default(0) @map("extreme_pressure_balls")
  highPressureBalls     Int     @default(0) @map("high_pressure_balls")
  lowPressureBalls      Int     @default(0) @map("low_pressure_balls")
  moderatePressureBalls Int     @default(0) @map("moderate_pressure_balls")
  totalValidBalls       Int     @default(0) @map("total_valid_balls")
  highExtremeSharePct   Float?  @map("high_extreme_share_pct")

  player Player @relation(fields: [playerId], references: [playerId], onDelete: Cascade)

  @@unique([discipline, playerId])
  @@index([discipline, evidenceTier])
  @@map("player_pressure_exposure")
}

// 7. Player Season Performance (3,008 rows across 2022–2026)
model PlayerSeasonPerformance {
  id                        Int    @id @default(autoincrement())
  discipline                String @map("discipline")
  playerId                  Int    @map("player_id")
  playerName                String @map("player_name")
  seasonYear                Int    @map("season_year")
  pressureBalls             Int    @default(0) @map("pressure_balls")
  pressureInnings           Int    @default(0) @map("pressure_innings")
  pressureMatches           Int    @default(0) @map("pressure_matches")
  pressureRunsOrConceded    Int    @default(0) @map("pressure_runs_or_conceded")
  pressureDismissalsOrWkts  Int    @default(0) @map("pressure_dismissals_or_wickets")
  primaryRate               Float? @map("primary_rate")
  netImpactRate             Float? @map("net_impact_rate")

  player Player @relation(fields: [playerId], references: [playerId], onDelete: Cascade)

  @@unique([discipline, playerId, seasonYear])
  @@index([discipline, seasonYear])
  @@index([playerId])
  @@map("player_season_performance")
}

// 8. Final Batting Rankings (173 eligible players from final_batting_rankings.csv; rank 1..10 matches submission CSV)
model BattingRanking {
  playerId                   Int     @id @map("player_id")
  rank                       Int     @unique @map("rank")
  isTop10                    Boolean @default(false) @map("is_top10")
  playerName                 String  @map("player_name")
  role                       String  @map("role")
  teamContext                String? @map("team_context")
  competitionContext         String  @map("competition_context")
  seasonsRepresented         String? @map("seasons_represented")
  evidenceTier               String  @map("evidence_tier")

  finalRankingScore          Float   @map("final_ranking_score")
  performanceScore           Float   @map("performance_score")
  reliabilityScore           Float   @map("reliability_score")
  evidenceScore              Float   @map("evidence_score")

