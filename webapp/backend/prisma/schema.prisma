// 4. Player Batting Reliability (824 rows — reliability_score MUST remain NULL for INSUFFICIENT_EVIDENCE)
model PlayerBattingReliability {
  playerId                     Int      @id @map("player_id")
  playerName                   String   @map("player_name")
  role                         String   @map("role")
  evidenceTier                 String   @map("evidence_tier")
  isPrimaryEligible            Boolean  @default(false) @map("is_primary_eligible")
  pressureBalls                Int      @default(0) @map("pressure_balls")
  pressureInnings              Int      @default(0) @map("pressure_innings")
  pressureMatches              Int      @default(0) @map("pressure_matches")
  pressureSeasons              Int      @default(0) @map("pressure_seasons")

  rawPressureImpact            Float?   @map("raw_pressure_impact")
  ebShrinkageWeight            Float?   @map("eb_shrinkage_weight")
  ebKMatchesPrior              Float?   @map("eb_k_matches_prior")
  ebPressureImpact             Float?   @map("eb_pressure_impact")
  inningsImpactIqr             Float?   @map("innings_impact_iqr")
  inningsImpactSd              Float?   @map("innings_impact_sd")
  seasonalImpactSd             Float?   @map("seasonal_impact_sd")

  compInningsStability         Float?   @map("comp_innings_stability")
  compFloorConsistency         Float?   @map("comp_floor_consistency")
  compCrossConditionStability  Float?   @map("comp_cross_condition_stability")
  compSeasonalStability        Float?   @map("comp_seasonal_stability")

  performanceScore             Float?   @map("performance_score")
  reliabilityScore             Float?   @map("reliability_score")
  evidenceStrengthScore        Float?   @map("evidence_strength_score")

  impactCi95Low                Float?   @map("impact_ci95_low")
  impactCi95High               Float?   @map("impact_ci95_high")
  impactCi95Width              Float?   @map("impact_ci95_width")
  impactBootSe                 Float?   @map("impact_boot_se")
  rawRateCi95Low               Float?   @map("raw_rate_ci95_low")
  rawRateCi95High              Float?   @map("raw_rate_ci95_high")

  contextImpactDiff            Float?   @map("context_impact_diff_p_minus_np")
  contextImpactDiffCi95Low     Float?   @map("context_impact_diff_ci95_low")
  contextImpactDiffCi95High    Float?   @map("context_impact_diff_ci95_high")
  ci95ExcludesZero             Boolean? @map("ci95_excludes_zero")
  sufficientBothSidesPrimary   Boolean? @map("sufficient_both_sides_primary")
  evidenceInterpretation       String?  @map("evidence_interpretation")

  player Player @relation(fields: [playerId], references: [playerId], onDelete: Cascade)

  @@index([evidenceTier])
  @@index([isPrimaryEligible])
  @@map("player_batting_reliability")
}

