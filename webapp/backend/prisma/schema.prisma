  inningsType                String   @map("innings_type")
  battingTeamId              Int      @map("batting_team_id")
  battingTeamName            String?  @map("batting_team_name")
  bowlingTeamId              Int      @map("bowling_team_id")
  bowlingTeamName            String?  @map("bowling_team_name")
  totalDeliveries            Int      @map("total_deliveries")
  legalDeliveries            Int      @map("legal_deliveries")
  batterBallsFaced           Int      @map("batter_balls_faced")
  wides                      Int      @default(0) @map("wides")
  overstepNoballs            Int      @default(0) @map("overstep_noballs")
  otherNoballs               Int      @default(0) @map("other_noballs")
  batterRuns                 Int      @map("batter_runs")
  extrasTotalRuns            Int      @map("extras_total_runs")
  totalRuns                  Int      @map("total_runs")
  bowlerConcededRuns         Int      @map("bowler_conceded_runs")
  wickets                    Int      @map("wickets")
  bowlerWickets              Int      @map("bowler_wickets")
  runOuts                    Int      @default(0) @map("run_outs")
  isDlsMatch                 Boolean  @default(false) @map("is_dls_match")
  isReducedOversMatch        Boolean  @default(false) @map("is_reduced_overs_match")

  battingPressureValidBalls  Int      @default(0) @map("batting_pressure_valid_balls")
  bowlingPressureValidBalls  Int      @default(0) @map("bowling_pressure_valid_balls")
  meanBattingPressure        Float?   @map("mean_batting_pressure")
  maxBattingPressure         Float?   @map("max_batting_pressure")
  highOrExtremeBattingBalls  Int      @default(0) @map("high_or_extreme_batting_balls")
  extremeBattingBalls        Int      @default(0) @map("extreme_batting_balls")
  meanBowlingPressure        Float?   @map("mean_bowling_pressure")
  maxBowlingPressure         Float?   @map("max_bowling_pressure")
  highOrExtremeBowlingBalls  Int      @default(0) @map("high_or_extreme_bowling_balls")
  extremeBowlingBalls        Int      @default(0) @map("extreme_bowling_balls")

  match Match @relation(fields: [matchId], references: [matchId], onDelete: Cascade)

  @@unique([matchId, innings])
  @@index([matchFormat, season])
  @@map("innings")
}

// 12. Pressure Summaries (outputs/pressure_*.csv: level summary, distributions, Models A/B/C comparison, components, exposure)
model PressureSummary {
  id          Int      @id @default(autoincrement())
  summaryType String   @map("summary_type")
  framework   String   @map("framework")
  segmentKey  String   @map("segment_key")
  payloadJson Json     @map("payload_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@unique([summaryType, framework, segmentKey])
  @@index([summaryType, framework])
  @@map("pressure_summaries")
}

// 13. Methodology Sections (20 sections parsed from submission/RR_Performance_Lab_Methodology_Report.md)
model MethodologySection {
