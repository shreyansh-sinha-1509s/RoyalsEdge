// RR PERFORMANCE LAB — PostgreSQL Schema (Neon Managed PostgreSQL)
// Prisma 6 ORM with pooled runtime URL (DATABASE_URL) + direct migration URL (DIRECT_URL)
// Strictly aligned with verified Phase 2–6 CSV schemas and webapp/docs/DATABASE_SCHEMA.md

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// 1. Canonical player master keyed strictly on integer player_id (never merged by shared name)
model Player {
  playerId               Int      @id @map("player_id")
  displayName            String   @map("standardized_display_name")
  mappingSourceNames     String?  @map("mapping_source_names")
  ballFeedSourceNames    String?  @map("ball_feed_source_names")
  teamNames              String?  @map("team_names")
  inIpl                  Boolean  @default(false) @map("in_ipl")
  inT20i                 Boolean  @default(false) @map("in_t20i")
  inExcludedComp         Boolean  @default(false) @map("in_excluded_non_ipl_t20")
  inPrimaryEligibleComp  Boolean  @default(false) @map("in_primary_eligible_comp")
  primaryBallsFaced      Int      @default(0) @map("primary_balls_faced")
  primaryLegalBallsBowled Int     @default(0) @map("primary_legal_balls_bowled")
  matchesInPlayingEleven Int      @default(0) @map("matches_in_playing_eleven")
  battingType            String?  @map("batting_type")
  bowlingType            String?  @map("bowling_type")
  paceOrSpin             String?  @map("pace_or_spin")
  everWk                 Boolean  @default(false) @map("ever_wk")
  everCaptain            Boolean  @default(false) @map("ever_captain")
  inferredPlayingRole    String?  @map("inferred_playing_role")
  nameMismatchSources    Boolean  @default(false) @map("name_mismatch_between_sources")
  sharesNameWithOtherId  Boolean  @default(false) @map("shares_name_with_other_player_id")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  battingPerformance  PlayerBattingPerformance?
  bowlingPerformance  PlayerBowlingPerformance?
  battingReliability  PlayerBattingReliability?
  bowlingReliability  PlayerBowlingReliability?
  pressureExposures   PlayerPressureExposure[]
  pressureBreakdowns  PlayerPressureBreakdown[]
  seasonPerformances  PlayerSeasonPerformance[]
  battingRanking      BattingRanking?
  bowlingRanking      BowlingRanking?

  @@index([displayName])
  @@index([inPrimaryEligibleComp])
  @@index([inferredPlayingRole])
  @@index([sharesNameWithOtherId])
  @@map("players")
}

